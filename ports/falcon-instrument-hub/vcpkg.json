{
  "name": "falcon-instrument-hub",
  "version": "3.0.11",
  "port-version": 11,
  "description": "Falcon Instrument Hub Go binary",
  "license": "BSD-3-Clause",
  "dependencies": [
    "json-schema-validator",
    "nlohmann-json",
    {
      "name": "falcon-core",
      "features": [
        "c-api"
      ],
      "version>=": "1.2.3"
    },
    "vcpkg-cmake",
    "vcpkg-cmake-config",
    "instrument-script-server",
    "yaml-cpp",
    "yaml-config-validator",
    {
      "name": "instrument-domain",
      "version>=": "1.0.0"
    },
    {
      "name": "instrument-target",
      "version>=": "1.0.0"
    }
  ],
  "overrides": [
    {
      "name": "libpqxx",
      "version": "7.10.5"
    },
    {
      "name": "xtensor",
      "version": "0.25.0"
    },
    {
      "name": "xtl",
      "version": "0.7.5"
    }
  ]
}
